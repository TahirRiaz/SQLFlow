# Copy this file to docker/.env to override the default credentials or host ports.
# docker/.env is git-ignored. The defaults below match docker-compose.yml and docker/README.md.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=deltaforge
POSTGRES_PORT=5432

# MySQL (root is the only account; the Sakila sample lives in the `sakila` database)
MYSQL_ROOT_PASSWORD=devpassword
MYSQL_DATABASE=sakila
MYSQL_PORT=3306

# Oracle (connect as system; the service name is FREEPDB1)
ORACLE_PASSWORD=devpassword
ORACLE_PORT=1521
