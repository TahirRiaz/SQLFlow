{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2023"],
    "skipLibCheck": true,
    "outDir": ".tsbuild/unit",
    "emitDeclarationOnly": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": [
    "unit/**/*.ts",
    "src/auth/entraSignIn.ts",
    "src/auth/loginStreamLanes.ts",
    "src/modules/branding.ts",
    "src/features/chat/answerSql.ts",
    "src/features/chat/queryResultPlan.ts",
    "src/features/nodes/scalingMode.ts",
    "src/features/repos/gitCredential.ts",
    "src/api/types.ts",
    "src/layout/workbench/sideBarStart.ts"
  ]
}
