# Copy to .env and set real values. Every secret lives here (or in your secret manager), never in the compose
# file or the images.

# SQL Server sa password (also used by the stack's connection strings). SQL Server enforces complexity.
MSSQL_SA_PASSWORD=

# HS256 signing key for control-plane tokens: at least 32 bytes of randomness.
SQLFLOW_JWT_SIGNING_KEY=

# Break-glass bootstrap secret: at least 32 bytes. Used once to provision users, then rotate or remove.
SQLFLOW_BOOTSTRAP_SECRET=

# Shared key between the control plane and the isolated Power BI extractor: at least 32 bytes of randomness.
SQLFLOW_EXTRACTOR_KEY=

# The initial admin user bootstrap provisioning creates (password at least 12 characters).
SQLFLOW_ADMIN_USERNAME=admin
SQLFLOW_ADMIN_PASSWORD=

# Optional: the pool the worker service serves (empty = untargeted runs only).
SQLFLOW_WORKER_POOL=

# Optional: the git credentials a repository source naming none is read with, by the control plane's sync and the
# worker's checkouts. A GitHub App first (read-only, installed on the repository; docs/reference/guides/github-app.md): its client ID, and its
# private key as the base64 of its .pem file (one line), for a remote on github.com. Then a token, for any other remote.
SQLFLOW_GITHUB_APP_ID=
SQLFLOW_GITHUB_APP_PRIVATE_KEY=
SQLFLOW_GIT_TOKEN=

# The worker's credential to the control plane: a personal access token minted with the 'node' scope once the
# control plane is up (sign in as the admin, POST /api/v1/me/tokens with scopes ["node"], or the GUI's token page).
# Start the stack without the worker first, mint the token, set it here, then `docker compose up -d worker`.
SQLFLOW_NODE_TOKEN=
