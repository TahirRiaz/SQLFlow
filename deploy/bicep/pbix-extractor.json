      "type": "string",
      "metadata": {
        "description": "The address the control plane reaches the extractor at (ControlPlane:PowerAI:ReportExtraction:Endpoint): the environment-internal FQDN."
      },
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', parameters('name')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "identityPrincipalId": {
      "type": "string",
      "metadata": {
        "description": "The principal (object) id of the app identity."
      },
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id', parameters('name'))), '2023-01-31').principalId]"
