# A SQLFlow compute node as a container: runs `sqlflow worker`, the pull-based drain loop over the control plane's
# dispatcher. It needs OUTBOUND HTTPS to the control plane, outbound SQL to the data its flows touch, and (for a
# pinned run without a snapshot) outbound git to the repo remotes; it never connects to the catalog and exposes
# nothing, so it never sits behind an ingress. Scale it on queue depth (see deploy/k8s for the KEDA setup), not on
# traffic.
#
# Configuration is environment-only, matching the worker's "credentials live on the node" model:
#   SQLFLOW_URL                   the control plane base URL (required)
#   SQLFLOW_TOKEN                 a personal access token with the node scope, or a ${env:...}/${keyvault:...}
#                                 reference to one (required)
#   SQLFLOW_WORKER_POOL           comma-separated pools this node serves (optional; empty = untargeted runs only)
#   SQLFLOW_WORKER_POLL_SECONDS   how long each poll waits for work (optional; default 30)
#   SQLFLOW_WORKER_DRAIN_SECONDS  how long a stopping node finishes what it holds (optional; default 540)
#   SQLFLOW_GIT_TOKEN             token for private git remotes (optional)
#   plus every ${env:...} reference the flows themselves use (source/target connection strings).
#
# Build from the repository root:
#   docker build -f Dockerfile.worker -t sqlflow-worker:latest .

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY . .
# Framework-dependent publish; building inside the linux SDK image restores the linux-x64 native assets the
# engine carries (LibGit2Sharp for materialization, the DuckDB reader), so they ship under runtimes/linux-x64.
RUN dotnet publish src/SqlFlow.Cli/SqlFlow.Cli.csproj \
    -c Release -o /app /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/runtime:9.0 AS runtime
# LibGit2Sharp's bundled native git needs OpenSSL present on the Debian runtime image for HTTPS remotes.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libssl3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app .
COPY deploy/docker/worker-entrypoint.sh /worker-entrypoint.sh
# The CR strip keeps the shebang valid when the build context comes from a Windows checkout (CRLF would make
# the kernel look for /bin/sh\r and fail the container with "no such file or directory").
RUN sed -i 's/\r$//' /worker-entrypoint.sh && chmod +x /worker-entrypoint.sh
ENV DOTNET_RUNNING_IN_CONTAINER=true
USER $APP_UID
ENTRYPOINT ["/worker-entrypoint.sh"]
