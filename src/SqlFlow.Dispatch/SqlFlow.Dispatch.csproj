<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SqlFlow.Dispatch</RootNamespace>
    <Description>The control plane's in-memory run dispatcher: the queue state, its gates (pool routing, wave order, group concurrency, one execution per pipeline), node leases, and the node protocol contracts. Pure and deterministic under an injected clock; the catalog is only a journal behind the IDispatchLedger port, so nothing here depends on a database or a web host.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SqlFlow.Dispatch.Tests" />
    <InternalsVisibleTo Include="SqlFlow.ControlPlane.Tests" />
  </ItemGroup>

</Project>
