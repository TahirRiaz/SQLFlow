<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SqlFlow.Node</RootNamespace>
    <Description>The compute-node runtime: the durable-queue drain loop (atomically claim a run, execute it through the shared engine, record the outcome) shared by the control-plane background worker and the standalone `sqlflow worker` agent. One node runtime, so a run executes identically whether it runs in-process in the control plane or on a self-hosted worker reachable from inside a private network.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- SHA-pinned git materialization: the node clones/checks out a flow's exact committed version to run it. -->
    <PackageReference Include="LibGit2Sharp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SqlFlow.ControlPlane.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlFlow.Core\SqlFlow.Core.csproj" />
    <ProjectReference Include="..\SqlFlow.Catalog\SqlFlow.Catalog.csproj" />
    <ProjectReference Include="..\SqlFlow.Execution\SqlFlow.Execution.csproj" />
    <ProjectReference Include="..\SqlFlow.Yaml\SqlFlow.Yaml.csproj" />
    <ProjectReference Include="..\SqlFlow.Orchestration\SqlFlow.Orchestration.csproj" />
  </ItemGroup>

</Project>
