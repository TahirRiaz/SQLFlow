<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SqlFlow.Azure</RootNamespace>
    <Description>Azure plugin: credential factory (Service Principal / Managed Identity / Azure CLI / DefaultAzureCredential) and Key Vault secret provider.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="Azure.ResourceManager" />
    <PackageReference Include="Azure.ResourceManager.DataFactory" />
    <PackageReference Include="Azure.ResourceManager.Automation" />
    <PackageReference Include="Azure.Storage.Blobs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlFlow.Core\SqlFlow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test suite exercises the auth-mode resolver and the env seam of the storage credential provider. -->
    <InternalsVisibleTo Include="SqlFlow.Core.Tests" />
  </ItemGroup>

</Project>
