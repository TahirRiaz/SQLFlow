<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SqlFlow.Core</RootNamespace>
    <Description>SQLFlow core: domain model, abstractions, and the stateless ETL engine. No SQL Server, YAML, or I/O dependencies.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test suite exercises engine-internal mechanisms (e.g. the watermark filtering reader) directly. -->
    <InternalsVisibleTo Include="SqlFlow.Core.Tests" />
  </ItemGroup>

</Project>
